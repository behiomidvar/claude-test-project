{
  "name": "deltalk-promo",
  "version": "0.1.0",
  "private": true,
  "description": "Deltalk promo video (Remotion)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "dev:harness": "remotion studio src/harness/index.ts",
    "ds:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-ds.mjs",
    "ds:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-ds.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint:rules": "node scripts/check-rules.mjs",
    "test:framesync": "node scripts/test-framesync.mjs",
    "render:test": "remotion render src/index.ts Deltalk-9x16 out/test.mp4 --codec h264"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "pngjs": "7.0.0",
    "typescript": "5.8.3"
  }
}
