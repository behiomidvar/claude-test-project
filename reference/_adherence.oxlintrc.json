{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/conversation/**",
              "components/core/**",
              "components/discovery/**",
              "components/feedback/**",
              "components/forms/**",
              "components/messaging/**",
              "components/onboarding/**",
              "components/safety/**",
              "theme-toggle.js",
              "ui_kits/deltalk-app/**",
              "ui_kits/deltalk-ui-kit/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IRANSansMobile|Hanken Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: IRANSansMobile, Hanken Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgeChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:years|variant|unit|onMedia|key|ref|className|style|children)$/]",
        "message": "<AgeChip> doesn't accept that prop. Declared props: years, variant, unit, onMedia."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgeChip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:chip|inline)$/]",
        "message": "<AgeChip> variant must be one of 'chip' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|name|size|blur|ring|progress|online|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, name, size, blur, ring, progress, online."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|muted|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, muted, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:warm|cool|active|neutral|success|danger|solid|count)$/]",
        "message": "<Badge> variant must be one of 'warm' | 'cool' | 'active' | 'neutral' | 'success' | 'danger' | 'solid' | 'count'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlockedUserItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|avatar|meta|unblocking|unblockLabel|onUnblock|key|ref|className|style|children)$/]",
        "message": "<BlockedUserItem> doesn't accept that prop. Declared props: name, avatar, meta, unblocking, unblockLabel, onUnblock."
